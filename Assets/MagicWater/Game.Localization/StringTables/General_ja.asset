        Array: []
  - m_Id: 175319297250361344
    m_Localized: '{0} コインのインスタント報酬を獲得！'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175319297254555648
    m_Localized: 30日間、毎日のコインボーナスを楽しもう！
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175312139930632192
    m_Localized: 毎日引き換え可能
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175312139930632193
