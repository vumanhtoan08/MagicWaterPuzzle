    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087234
    m_Localized: シャッフルを{0}回使用する
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087235
    m_Localized: 整理を{0}回使用する
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087236
    m_Localized: ターボを{0}回使用する
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087237
    m_Localized: 復活を{0}回使用する
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087238
    m_Localized: 'リフレッシュまで:'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087239
    m_Localized: デイリークエスト
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165373590277087240
    m_Localized: ウィークリークエスト
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165505240620138496
    m_Localized: タップして受け取る
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165511316954480640
    m_Localized: VIPを{0}回使用する
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165896719884681216
    m_Localized: VIPスロット
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165896719964372992
    m_Localized: 任意の車をVIPスペースに移動
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 167319226869153792
    m_Localized: 一回限りの購入
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168001317445369856
    m_Localized: 色覚異常
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168007607378837504
    m_Localized: コミュニティ
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286864236544
    m_Localized: ガレージ
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208064
    m_Localized: '"前のスペースがクリアになると車がガレージから出ます。"'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208065
    m_Localized: '"現在の車が出ると次の車が現れます"'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208066
    m_Localized: 車の数
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208067
    m_Localized: "車が出てくるときだけ見る。\n残りの数を確認してください。"
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168323573291745280
    m_Localized: 毎日ログイン
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168323573308522496
    m_Localized: 日
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168323573308522497
    m_Localized: 新しい報酬を求めて毎日来てください！
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168323852376539136
    m_Localized: 毎日
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 169405851543601152
    m_Localized: 新機能
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 169419130080919552
    m_Localized: 車は矢印の方向に進みます
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 170582695601045504
    m_Localized: 利用不可
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 171760282386980864
    m_Localized: 改善しました！
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 171760282462478336
    m_Localized: ゲームをより良い体験にするためにいくつかの変更を加えました！
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 171760282462478337
    m_Localized: 今すぐアップグレード
    m_Metadata:
      m_Items:
        Array: []
