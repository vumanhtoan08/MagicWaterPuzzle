    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 165896719964372992
    m_Localized: Chuyển bất kỳ xe nào đến vị trí VIP
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 167319226869153792
    m_Localized: Mua một lần
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168001317445369856
    m_Localized: Mù màu
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168007607378837504
    m_Localized: Cộng đồng
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286864236544
    m_Localized: Nhà xe
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208064
    m_Localized: '"Xe sẽ rời khỏi nhà xe khi không gian phía trước đã trống."'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208065
    m_Localized: '"Chiếc xe hiện tại rời đi, chiếc tiếp theo sẽ xuất hiện."'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208066
    m_Localized: Số lượng xe
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 168034286885208067
    m_Localized: '"Chỉ thấy xe khi nó chạy ra. Kiểm tra biển báo để biết còn bao nhiêu."'
    m_Metadata:
      m_Items:
        Array: []
