    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 158815030965592064
    m_Localized: Giao dịch đã được khôi phục
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 160068368762732544
    m_Localized: Khoang chứa của xe buýt
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 160068368787898368
    m_Localized: '"Khoang chứa của xe buýt đã đầy. Mua ngay để tiết kiệm nhiều xu."'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 160068368787898369
    m_Localized: '"Khoang chứa của xe buýt chưa đầy, tiếp tục chơi để thêm xu!"'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 160068368787898370
    m_Localized: Chỉ có sẵn cho giao dịch một lần.
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 160075055548661760
    m_Localized: Gói hỗ trợ
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 160075055548661761
    m_Localized: Mở khóa phần thưởng miễn phí với gói mua của bạn!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 162608371355156480
    m_Localized: KHÁCH HÀNG ẨN
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 162608371367739392
    m_Localized: Vị khách đặc biệt của chúng tôi có màu sắc ẩn!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 162608371367739393
    m_Localized: Không xuất hiện ngay đầu hàng!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 162608371367739394
    m_Localized: Hãy chào đón họ lên xe!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 162608371367739395
    m_Localized: Chúng ta đi thôi! Woohoo!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 162608371367739396
