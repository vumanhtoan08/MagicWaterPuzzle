      m_Items:
        Array: []
  - m_Id: 185422659790635008
    m_Localized: लूनर व्हील
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185432485076815874
    m_Localized: अधिक स्ट्रीक प्राप्त करें और गेम जीतें डायनामाइट्स प्राप्त करें
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185432485076815875
    m_Localized: व्हील को पूरी तरह चार्ज करें स्पिन अनलॉक करने के लिए।
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185432485076815876
    m_Localized: "पटाखे तैयार हैं\nचलो तुम्हारा भाग्यशाली इनाम प्राप्त करें!"
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185798923013652480
    m_Localized: खोलें
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185798923017846784
    m_Localized: बचा
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 206488820224483328
    m_Localized: दावा करें X2
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 1
