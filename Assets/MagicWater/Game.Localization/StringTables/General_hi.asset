    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185361311328260096
    m_Localized: 'मानक पुरस्कार दर: {0}%'
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185387325395718144
    m_Localized: आप <color=#911E07>इसे खो देंगे</color>,
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 185432485076815872
    m_Localized: '{0} स्तर पुरस्कार'
