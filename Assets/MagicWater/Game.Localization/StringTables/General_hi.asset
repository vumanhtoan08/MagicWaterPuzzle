    m_Localized: अब खरीदें और दावा करें
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175317142929997824
    m_Localized: बूस्टर पास
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175319580445573120
    m_Localized: 30 दिनों तक हर दिन 1 बूस्टर प्राप्त करें!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175329212887007232
    m_Localized: साहसिक पास
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175329212887007233
    m_Localized: पूरे महीने दैनिक सिक्के और रोमांचक बूस्टर प्राप्त करें!
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175332311076765696
    m_Localized: बंद करने के लिए टैप करें
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175342191208628224
    m_Localized: सभी दावा करें
    m_Metadata:
      m_Items:
        Array: []
  - m_Id: 175516609940709376
